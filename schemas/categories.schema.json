{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chinese Ingredient API: categories",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "description"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "categories"
  ]
}
